# Room Snapshot API environment template.
# Copy to .env and edit. The real .env is not tracked by git.

# Shared credentials used for cameras without a per-camera record in cameras.auth.
RTSP_AUTH="admin:admin"

# Shared API key required by every REST and MCP request (X-API-Key / Bearer).
API_KEY="generate-a-strong-key"

# Comma-separated list of allowed CORS origins. Empty means cross-origin is blocked.
CORS_ORIGINS=""

# Default room-name language: "en" or "ru".
DEFAULT_LANG="en"

# Seconds a captured snapshot stays in the in-memory cache.
SNAPSHOT_CACHE_TTL="5"

# ffmpeg capture timeout in seconds.
SNAPSHOT_TIMEOUT="15"

# Maximum number of ffmpeg processes running at the same time.
MAX_CONCURRENT_CAPTURES="4"

# Optional per-client request limit per minute; 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE="0"

FLASK_DEBUG=false
HOST="0.0.0.0"
PORT="5000"

# Port for the MCP server (streamable HTTP).
MCP_PORT="8000"

# Directory with the installation files. Inside Docker the compose file mounts
# ./config here; these three override the individual paths when needed.
# CONFIG_DIR="/app/config"
# CAMERAS_CONF="/app/config/cameras.conf"
# CAMERAS_AUTH="/app/config/cameras.auth"
# ROOMS_I18N="/app/config/rooms.i18n.json"
